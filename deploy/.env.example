# Скопируйте в .env и поменяйте значения.
# .env в git не попадает (.gitignore).
#
# Эти значения — для локального запуска. На сервере пароли должны быть
# сгенерированы: openssl rand -base64 24

POSTGRES_DB=discord_clone
POSTGRES_USER=dc
POSTGRES_PASSWORD=devpass
POSTGRES_PORT=5432

REDIS_PORT=6379

# SeaweedFS (S3). Ключи дублируются в deploy/seaweedfs-s3.json:
# файл читает сам SeaweedFS, переменные — для справки и будущего .env.
STORAGE_ACCESS_KEY=dcstorage
STORAGE_SECRET_KEY=devstorage123
STORAGE_PORT=8333
STORAGE_BUCKET=discord-clone
